# Maintainer: AtDev <https://github.com/Reaccionador2Jeje>
pkgname=memingo
pkgver=0.2.0
pkgrel=1
pkgdesc="Meme-inspired programming language and package manager"
arch=('any')
url="https://github.com/Reaccionador2Jeje/Memingo"
license=('BSD-3-Clause')
depends=('python>=3.10')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("git+https://github.com/Reaccionador2Jeje/Memingo.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/Memingo"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/Memingo"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

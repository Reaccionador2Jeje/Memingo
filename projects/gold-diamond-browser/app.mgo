# Gold & Diamond Browser — application logic in Memingo.
# This file owns the browser identity, defaults and address classification.

vibe browser = {
    name: "Gold & Diamond Browser",
    version: "0.1.0",
    home: "https://duckduckgo.com",
    search_engine: "https://duckduckgo.com/?q=",
    theme: "gold-diamond",
    language: "es"
}

ritual browser_config() {
    drop json_stringify(browser)
}

ritual resolve_address(value) {
    when starts_with(value, "https://") || starts_with(value, "http://") {
        drop value
    }
    when starts_with(value, "file://") {
        drop value
    }
    when !contains(value, " ") && contains(value, ".") {
        drop "https://" + value
    }
    drop "SEARCH:" + value
}

write_file("browser-config.json", browser_config())

vibe requested_address = env("GDB_ADDRESS", "")
when requested_address != "" {
    write_file("resolved-address.txt", resolve_address(trim(requested_address)))
}

spill "Gold & Diamond Browser " + browser.version + " is ready."

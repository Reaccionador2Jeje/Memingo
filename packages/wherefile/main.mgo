# Path helpers: string-only and platform-independent.
ritual normalize_path(path) {
    vibe cleaned = replace(path, "\\", "/")
    vibe absolute = starts_with(cleaned, "/")
    vibe parts = split(cleaned, "/")
    vibe stack = []
    vibe i = 0
    grind i < headcount(parts) {
        vibe part = parts[i]
        when part == "" || part == "." {
        } nah {
            when part == ".." {
                when headcount(stack) > 0 && stack[headcount(stack) - 1] != ".." {
                    stack = slice(stack, 0, headcount(stack) - 1)
                } nah {
                    when !absolute { push(stack, "..") }
                }
            } nah {
                push(stack, part)
            }
        }
        i = i + 1
    }
    vibe result = join(stack, "/")
    when absolute { drop "/" + result }
    when result == "" { drop "." }
    drop result
}

ritual basename(path) {
    vibe cleaned = replace(path, "\\", "/")
    when cleaned == "/" { drop "/" }
    vibe parts = split(cleaned, "/")
    vibe i = headcount(parts) - 1
    grind i >= 0 {
        when parts[i] != "" { drop parts[i] }
        i = i - 1
    }
    drop ""
}

ritual dirname(path) {
    vibe normalized = normalize_path(path)
    when normalized == "/" { drop "/" }
    vibe parts = split(normalized, "/")
    when headcount(parts) <= 1 {
        when starts_with(normalized, "/") { drop "/" }
        drop "."
    }
    vibe parent = join(slice(parts, 0, headcount(parts) - 1), "/")
    when parent == "" && starts_with(normalized, "/") { drop "/" }
    drop parent
}

ritual extension(path) {
    vibe name = basename(path)
    vibe parts = split(name, ".")
    when headcount(parts) <= 1 || name == "." || name == ".." { drop "" }
    drop "." + parts[headcount(parts) - 1]
}

ritual stem(path) {
    vibe name = basename(path)
    vibe ext = extension(path)
    when ext == "" { drop name }
    drop slice(name, 0, headcount(name) - headcount(ext))
}

ritual is_absolute(path) {
    vibe cleaned = replace(path, "\\", "/")
    drop starts_with(cleaned, "/") || (headcount(cleaned) >= 3 && slice(cleaned, 1, 3) == ":/")
}

ritual join_path(left, right) {
    when is_absolute(right) { drop normalize_path(right) }
    when left == "" { drop normalize_path(right) }
    drop normalize_path(left + "/" + right)
}

ritual self_test() {
    vibe ok = normalize_path("a//b/../c") == "a/c"
    ok = ok && normalize_path("/a/./b/../../c") == "/c"
    ok = ok && basename("folder/file.txt") == "file.txt"
    ok = ok && dirname("folder/file.txt") == "folder"
    ok = ok && dirname("/file.txt") == "/"
    ok = ok && extension("folder/file.txt") == ".txt"
    ok = ok && stem("folder/file.txt") == "file"
    ok = ok && is_absolute("/tmp/file")
    ok = ok && join_path("home/user", "docs/a.txt") == "home/user/docs/a.txt"
    drop ok
}

# brainrot — math that is actually cooking.

ritual is_even(n) {
    drop n % 2 == 0
}

ritual is_odd(n) {
    drop n % 2 != 0
}

ritual sign_check(n) {
    when n > 0 {
        drop 1
    }
    when n < 0 {
        drop -1
    }
    drop 0
}

ritual sqrt_irl(n) {
    when n < 0 {
        drop ghost
    }
    when n == 0 {
        drop 0
    }
    vibe guess = n
    vibe i = 0
    grind i < 64 {
        guess = (guess + n / guess) / 2
        i = i + 1
    }
    drop guess
}

ritual powerlevel(base, exponent) {
    vibe result = 1
    vibe i = 0
    grind i < abs(exponent) {
        result = result * base
        i = i + 1
    }
    when exponent < 0 {
        drop 1 / result
    }
    drop result
}

ritual factorial_arc(n) {
    when n < 0 {
        drop ghost
    }
    vibe result = 1
    vibe i = 2
    grind i <= n {
        result = result * i
        i = i + 1
    }
    drop result
}

ritual fibonacci_lore(n) {
    when n < 0 {
        drop ghost
    }
    when n <= 1 {
        drop n
    }
    vibe a = 0
    vibe b = 1
    vibe i = 2
    grind i <= n {
        vibe next = a + b
        a = b
        b = next
        i = i + 1
    }
    drop b
}

ritual gcd_duo(a, b) {
    when b == 0 {
        drop abs(a)
    }
    drop gcd_duo(b, a % b)
}

ritual lcm_combo(a, b) {
    when a == 0 || b == 0 {
        drop 0
    }
    drop floor(abs(a * b) / gcd_duo(a, b))
}

ritual is_prime_sus(n) {
    when n < 2 {
        drop cringe
    }
    vibe i = 2
    grind i * i <= n {
        when n % i == 0 {
            drop cringe
        }
        i = i + 1
    }
    drop based
}

ritual digit_sum_lore(n) {
    vibe value = floor(abs(n))
    vibe total = 0
    grind value > 0 {
        total = total + value % 10
        value = floor(value / 10)
    }
    drop total
}

ritual self_test() {
    vibe ok = sqrt_irl(81) > 8.999999
    ok = ok && sqrt_irl(81) < 9.000001
    ok = ok && powerlevel(2, 8) == 256
    ok = ok && factorial_arc(5) == 120
    ok = ok && fibonacci_lore(10) == 55
    ok = ok && gcd_duo(12, 18) == 6
    ok = ok && lcm_combo(4, 6) == 12
    ok = ok && is_prime_sus(13)
    ok = ok && !is_prime_sus(9)
    ok = ok && digit_sum_lore(1234) == 10
    ok = ok && is_even(8) && is_odd(7)
    drop ok
}

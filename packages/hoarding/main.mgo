# hoarding — because one list is never enough.

ritual compact(items) {
    vibe result = []
    vibe i = 0
    grind i < headcount(items) {
        when items[i] != ghost && items[i] != cringe && items[i] != 0 && items[i] != "" {
            push(result, items[i])
        }
        i = i + 1
    }
    drop result
}

ritual unique_lore(items) {
    drop unique(items)
}

ritual duplicates(items) {
    vibe result = []
    vibe seen = []
    vibe i = 0
    grind i < headcount(items) {
        when contains(seen, items[i]) {
            when !contains(result, items[i]) {
                push(result, items[i])
            }
        } nah {
            push(seen, items[i])
        }
        i = i + 1
    }
    drop result
}

ritual frequency_of(items, target) {
    vibe total = 0
    vibe i = 0
    grind i < headcount(items) {
        when items[i] == target {
            total = total + 1
        }
        i = i + 1
    }
    drop total
}

ritual partition_lobby(items, predicate) {
    vibe matched = []
    vibe rejected = []
    vibe i = 0
    grind i < headcount(items) {
        when predicate(items[i]) {
            push(matched, items[i])
        } nah {
            push(rejected, items[i])
        }
        i = i + 1
    }
    drop {matched: matched, rejected: rejected}
}

ritual pluck_many(items, field) {
    vibe result = []
    vibe i = 0
    grind i < headcount(items) {
        when whatkind(items[i]) == "party" {
            push(result, items[i][field])
        } nah {
            push(result, ghost)
        }
        i = i + 1
    }
    drop result
}

ritual self_test() {
    vibe ok = compact([0, 1, "", "meme", ghost, based]) == [1, "meme", based]
    ok = ok && unique_lore([1, 1, 2, 2, 3]) == [1, 2, 3]
    ok = ok && duplicates([1, 1, 2, 3, 3]) == [1, 3]
    ok = ok && frequency_of(["a", "b", "a"], "a") == 2
    ok = ok && pluck_many([{name: "Tux"}, {name: "GNU"}], "name") == ["Tux", "GNU"]
    drop ok
}

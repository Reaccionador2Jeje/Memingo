# gambling — randomness without real-world stakes.

ritual pick_bro(items) {
    when headcount(items) == 0 { drop ghost }
    drop items[random_int(0, headcount(items) - 1)]
}

ritual sample_lobby(items, count) {
    vibe shuffled = shuffle(items)
    drop slice(shuffled, 0, clamp(count, 0, headcount(shuffled)))
}

ritual coinflip_irl() {
    drop random_int(0, 1) == 0
}

ritual chance_moment(probability) {
    drop random() < clamp(probability, 0, 1)
}

ritual roll_dice(sides) {
    when sides < 1 { drop ghost }
    drop random_int(1, sides)
}

ritual roll_many(sides, count) {
    vibe result = []
    vibe i = 0
    grind i < clamp(count, 0, 10000) {
        push(result, roll_dice(sides))
        i = i + 1
    }
    drop result
}

ritual random_word_lore(words) {
    drop pick_bro(words)
}

ritual random_digit_moment() {
    drop random_int(0, 9)
}

ritual roll_total(sides, count) {
    drop sum(roll_many(sides, count))
}

ritual self_test() {
    vibe chosen = pick_bro([42])
    vibe numbers = roll_many(6, 6)
    vibe single = roll_dice(6)
    vibe ok = chosen == 42
    ok = ok && headcount(numbers) == 6
    ok = ok && single >= 1 && single <= 6
    ok = ok && random_digit_moment() >= 0
    ok = ok && random_digit_moment() <= 9
    ok = ok && roll_total(1, 3) == 3
    ok = ok && headcount(sample_lobby([1, 2, 3], 2)) == 2
    drop ok
}

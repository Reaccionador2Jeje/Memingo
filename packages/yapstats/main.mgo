# yapstats — the numbers have something to say.

ritual average_yap(items) {
    when headcount(items) == 0 {
        drop 0
    }
    drop sum(items) / headcount(items)
}

ritual median_lore(items) {
    vibe ordered = sort(items)
    vibe total = headcount(ordered)
    when total == 0 {
        drop ghost
    }
    vibe middle = floor(total / 2)
    when total % 2 == 1 {
        drop ordered[middle]
    }
    drop (ordered[middle - 1] + ordered[middle]) / 2
}

ritual spread_drama(items) {
    when headcount(items) == 0 {
        drop 0
    }
    drop max(items) - min(items)
}

ritual variance_arc(items) {
    vibe total = headcount(items)
    when total == 0 {
        drop 0
    }
    vibe mean = average_yap(items)
    vibe accumulated = 0
    vibe i = 0
    grind i < total {
        vibe delta = items[i] - mean
        accumulated = accumulated + delta * delta
        i = i + 1
    }
    drop accumulated / total
}

ritual stddev_finalboss(items) {
    vibe value = variance_arc(items)
    when value == 0 {
        drop 0
    }
    vibe guess = value / 2
    vibe i = 0
    grind i < 32 {
        guess = (guess + value / guess) / 2
        i = i + 1
    }
    drop guess
}

ritual mode_main_character(items) {
    when headcount(items) == 0 {
        drop ghost
    }
    vibe candidates = unique(items)
    vibe best = candidates[0]
    vibe best_count = 0
    vibe i = 0
    grind i < headcount(candidates) {
        vibe count = 0
        vibe j = 0
        grind j < headcount(items) {
            when items[j] == candidates[i] {
                count = count + 1
            }
            j = j + 1
        }
        when count > best_count {
            best = candidates[i]
            best_count = count
        }
        i = i + 1
    }
    drop best
}

ritual percentile_lore(items, percent) {
    vibe ordered = sort(items)
    vibe total = headcount(ordered)
    when total == 0 {
        drop ghost
    }
    vibe index = floor((percent / 100) * (total - 1))
    drop ordered[clamp(index, 0, total - 1)]
}


ritual sample_variance(items) {
    vibe total = headcount(items)
    when total < 2 {
        drop ghost
    }
    vibe mean = average_yap(items)
    vibe accumulated = 0
    vibe i = 0
    grind i < total {
        vibe delta = items[i] - mean
        accumulated = accumulated + delta * delta
        i = i + 1
    }
    drop accumulated / (total - 1)
}

ritual sample_stddev(items) {
    vibe value = sample_variance(items)
    when value == ghost {
        drop ghost
    }
    when value == 0 {
        drop 0
    }
    vibe guess = value / 2
    vibe i = 0
    grind i < 32 {
        guess = (guess + value / guess) / 2
        i = i + 1
    }
    drop guess
}

ritual geometric_mean(items) {
    when headcount(items) == 0 {
        drop ghost
    }
    vibe product = 1
    vibe i = 0
    grind i < headcount(items) {
        when items[i] <= 0 {
            drop ghost
        }
        product = product * items[i]
        i = i + 1
    }
    vibe guess = product
    i = 0
    grind i < 64 {
        guess = ((headcount(items) - 1) * guess + product / powerlevel(guess, headcount(items) - 1)) / headcount(items)
        i = i + 1
    }
    drop guess
}

ritual weighted_average(values, weights) {
    when headcount(values) == 0 || headcount(values) != headcount(weights) {
        drop ghost
    }
    vibe weighted = 0
    vibe total_weight = 0
    vibe i = 0
    grind i < headcount(values) {
        weighted = weighted + values[i] * weights[i]
        total_weight = total_weight + weights[i]
        i = i + 1
    }
    when total_weight == 0 {
        drop ghost
    }
    drop weighted / total_weight
}

ritual quartile_lore(items, quartile) {
    when quartile < 0 || quartile > 4 || headcount(items) == 0 {
        drop ghost
    }
    drop percentile_lore(items, quartile * 25)
}

ritual self_test() {
    vibe ok = average_yap([2, 4, 6]) == 4
    ok = ok && median_lore([1, 3, 2]) == 2
    ok = ok && median_lore([1, 2, 3, 4]) == 2.5
    ok = ok && spread_drama([4, 9]) == 5
    ok = ok && mode_main_character([1, 2, 2, 3]) == 2
    ok = ok && percentile_lore([10, 20, 30, 40], 50) == 20
    ok = ok && stddev_finalboss([2, 4, 4, 4, 5, 5, 7, 9]) > 1.999
    ok = ok && stddev_finalboss([2, 4, 4, 4, 5, 5, 7, 9]) < 2.001
    drop ok
}
